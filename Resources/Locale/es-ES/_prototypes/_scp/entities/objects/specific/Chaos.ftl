ent-ChaosSpyUplinkImplant = implante de terminal
    .desc = Este implante permite al usuario acceder a un terminal oculto de la Insurgencia del Caos.
    .suffix = Caos
ent-ChaosSpyUplinkImplanter = { ent-BaseImplanter }
    .desc = Una jeringuilla compacta de un solo uso, diseñada exclusivamente para administrar implantes subcutáneos. Después de usarla, asegúrate de limpiarla con jabón o un trapo para eliminar cualquier rastro de ADN.
    .suffix = Terminal, Caos

ent-ActionOpenTerminalImplant = Abrir terminal
    .desc = Abre el terminal de la Insurgencia del Caos oculto bajo tu piel.

ent-UplinkChaos = terminal de la Insurgencia del Caos
    .desc = Utilizado por las fuerzas de la Insurgencia del Caos para llevar a cabo operaciones especiales.
    .suffix = Normal
ent-LeaderUplinkChaos = { ent-UplinkChaos }
    .desc = { ent-UplinkChaos.desc }
    .suffix = Líder

ent-ChaosPinpointer = localizador de la Insurgencia del Caos
    .desc = Un localizador especializado comprado en el mercado negro.
ent-ChaosPinBall = pelota
    .desc = Una pelota sospechosamente verde, ¿no crees?
