ent-RightHarmArm0492 = brazo derecho malévolo
    .desc = Un brazo de acero oscuro. Al sustituir quirúrgicamente el brazo derecho, el paciente obtiene la capacidad de asestar con él golpes dolorosos a sus enemigos.
    .suffix = SCP-049-2
ent-LeftTubeArm0492 = brazo izquierdo tubular
    .desc = Un tubo alargado de cobre. Al sustituir quirúrgicamente el brazo izquierdo, el paciente obtiene la capacidad de disparar sus propios desechos corporales a través del tubo.
    .suffix = SCP-049-2
ent-LeftSpringLeg0492 = pierna izquierda con muelle
    .desc = Un gran muelle plateado. Al sustituir quirúrgicamente la pierna izquierda, el paciente empieza a moverse más deprisa.
    .suffix = SCP-049-2
ent-OrganFlashEyes0492 = ojos tubulares
    .desc = Dos tubos flexibles con bombillas en los extremos. Al sustituir quirúrgicamente los ojos, el paciente deja de quedar cegado por los destellos.
    .suffix = SCP-049-2
ent-OrganTubeLungs0492 = pulmones de bomba
    .desc = Una bomba hecha de caucho negro bastante duro. Al sustituir quirúrgicamente los pulmones, el paciente evita las caídas y deja de resbalar.
    .suffix = SCP-049-2
ent-OrganLightingRodLiver0492 = hígado pararrayos
    .desc = Una pieza compacta de cobre de un pararrayos. Al sustituir quirúrgicamente el hígado, el paciente no puede sufrir descargas eléctricas.
    .suffix = SCP-049-2
