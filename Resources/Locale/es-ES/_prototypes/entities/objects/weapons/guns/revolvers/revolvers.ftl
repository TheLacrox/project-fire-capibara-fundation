ent-BaseWeaponRevolver = BaseWeaponRevolver
    .desc = Una de esas cosas para apuntar y hacer pum.
ent-WeaponRevolverDeckard = Deckard
    .desc = Un revólver de fabricación artesanal, mecanizado con una precisión preciosa. Se usa cuando no hay tiempo para el test de Voight-Kampff. Admite 5 cartuchos de .45 magnum.
ent-WeaponRevolverInspector = Inspector
    .desc = Un revólver de acción simple que fabrican varias empresas. Se consigue con facilidad en el mercado civil, lo que lo ha vuelto muy popular entre los investigadores privados. Solo con sostenerlo te sientes afortunado. Admite 6 cartuchos de .45 magnum.
ent-WeaponRevolverMateba = Mateba
    .desc = Un revólver moderno que usa el escuadrón de la muerte de Nanotrasen, esa unidad de élite casi mítica. Su mecanismo de disparo y la posición del cañón, ambos únicos, permiten una cadencia alta con un retroceso mínimo. Muchos han mirado por este cañón, pero pocos han vivido para contarlo. Admite 6 cartuchos de .45 magnum.
ent-WeaponRevolverMatebaAP = { ent-WeaponRevolverMateba }
    .suffix = Perforante
    .desc = { ent-WeaponRevolverMateba.desc }
ent-WeaponRevolverPython = Python
    .desc = Un potente revólver de acción doble fabricado por el Sindicato. Ruidoso y llamativo, perfecto para cualquier agente que quiera dejar clara su postura. Admite 6 cartuchos de .45 magnum.
ent-WeaponRevolverPythonAP = { ent-WeaponRevolverPython }
    .suffix = Perforante
    .desc = { ent-WeaponRevolverPython.desc }
ent-WeaponRevolverPirate = revólver pirata
    .desc = Un tosco revólver de acción simple fabricado a mano por un pirata espacial. Viejo y cubierto de óxido, aun así sigue funcionando. Admite 5 cartuchos de .45 magnum.
ent-WeaponRevolverPirateEmpty = { ent-WeaponRevolverPirate }
    .suffix = Vacío
    .desc = { ent-WeaponRevolverPirate.desc }
