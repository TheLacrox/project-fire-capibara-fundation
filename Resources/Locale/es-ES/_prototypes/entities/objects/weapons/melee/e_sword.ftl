ent-BaseMeleeWeaponEnergy = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-EnergySword = espada de energía
    .desc = Una espada muy ruidosa y peligrosa con una hoja de plasma puro y concentrado. Corta objetivos sin armadura como si fueran mantequilla.
ent-EnergyDaggerLoud = daga de energía
    .desc = Una daga algo menos ruidosa y peligrosa con una hoja de plasma puro y concentrado. Esta no intenta ocultarse en absoluto.
ent-EnergyDagger = bolígrafo
    .desc = Un bolígrafo de tinta oscura.
    .suffix = E-Dagger
ent-EnergyDaggerBox = caja de E-Dagger
    .desc = Una pequeña caja que contiene una E-Dagger. El embalaje se desintegra al abrirlo y no deja ninguna prueba.
    .suffix = E-Dagger
ent-EnergyCutlass = sable de energía
    .desc = Un arma de energía exótica.
ent-EnergySwordDouble = espada de energía de doble hoja
    .desc = Los becarios del mando del Sindicato pensaron que una sola hoja no bastaba para una espada de energía. Cabe en los bolsillos.
ent-HyperEutacticBlade = hoja hipereutáctica
    .desc = Concebida como un arma supermasiva capaz de partir en dos el propio tejido del espacio-tiempo, la hoja hipereutáctica forja dinámicamente y en un instante una nanoestructura cristalina hipereutáctica que atraviesa casi todas las formas de materia conocidas como un cuchillo caliente atraviesa la mantequilla.
ent-CyborgEnergySwordDouble = { ent-EnergySwordDouble }
    .desc = Los becarios del mando del Sindicato pensaron que una sola hoja no bastaba para una espada de energía. Diseñada especialmente para cíborgs del Sindicato.
    .suffix = A una mano, Para cíborgs
ent-EnergyDaggerLoudBlue = { ent-EnergyDaggerLoud }
    .suffix = Azul
    .desc = { ent-EnergyDaggerLoud.desc }
