ent-DisposalPipeBase = { "" }
    .desc = { "" }
ent-DisposalHolder = contenedor de residuos
    .desc = { "" }
ent-DisposalPipeBroken = tubería de residuos rota
    .desc = Una TGR (tubería gorda rota).
ent-DisposalPipe = segmento de tubería de residuos
    .desc = Un gran segmento de tubería empleado para construir sistemas de residuos.
ent-DisposalTagger = etiquetador de tuberías de residuos
    .desc = Una tubería que etiqueta entidades para dirigirlas.
ent-DisposalSignaller = emisor de señales de residuos
    .desc = Una tubería que emite una señal cuando pasa un objeto por ella.
ent-DisposalTrunk = troncal de residuos
    .desc = Un troncal que sirve como punto de entrada a los sistemas de residuos.
ent-DisposalRouter = enrutador de residuos
    .desc = Un enrutador de tres vías. Las entidades con etiquetas coincidentes se desvían hacia un lado mediante filtros configurables.
ent-DisposalRouterFlipped = { ent-DisposalRouter }
    .desc = Un enrutador de tres vías. Las entidades con etiquetas coincidentes se desvían hacia un lado.
    .suffix = Invertido
ent-DisposalJunction = unión de residuos
    .desc = Una unión de tres vías. La flecha indica por dónde salen los objetos.
ent-DisposalJunctionFlipped = { ent-DisposalJunction }
    .desc = Una unión de tres vías. La flecha indica por dónde salen los objetos.
    .suffix = Invertido
ent-DisposalYJunction = unión en Y de residuos
    .desc = Una unión de tres vías con un punto de salida adicional.
ent-DisposalXJunction = unión en X de residuos
    .desc = Una unión de cuatro vías. La flecha indica por dónde salen los objetos.
ent-DisposalBend = codo de residuos
    .desc = Un tubo doblado en un ángulo de 90 grados.
ent-DisposalSignalRouter = enrutador de señales de residuos
    .desc = Un enrutador de tres vías controlado por señales.
ent-DisposalSignalRouterFlipped = { ent-DisposalSignalRouter }
    .suffix = Invertido
    .desc = { ent-DisposalSignalRouter.desc }
