ent-JetpackImprovised = mochila propulsora improvisada
    .suffix = Vacía
    .desc = Es una mochila propulsora. Puede contener 1,5 l de gas.
ent-JetpackImprovisedFilled = mochila propulsora improvisada
    .suffix = Llena
    .desc = { ent-JetpackImprovised.desc }
ent-JetpackVoidEngineer = mochila propulsora de vacío del ingeniero jefe
    .suffix = Vacía
    .desc = Es una mochila propulsora. Puede contener 5 l de gas.
ent-JetpackVoidEngineerFilled = mochila propulsora de vacío del ingeniero jefe
    .suffix = Llena
    .desc = { ent-JetpackVoidEngineer.desc }
ent-JetpackSSFMarine = mochila propulsora de marine de la SSF
    .suffix = Vacía
    .desc = Mochila propulsora reglamentaria de fabricación soviética para su uso en el espacio.
ent-JetpackSSFMarineFilled = mochila propulsora de marine de la SSF
    .suffix = Llena
    .desc = { ent-JetpackSSFMarine.desc }
ent-PirateJetpack = mochila propulsora pirata
    .suffix = Pirata
    .desc = Una mochila propulsora pirata para surcar los mares del espacio.
ent-PirateJetpackFilled = { ent-PirateJetpack }
    .suffix = Llena, pirata
    .desc = { ent-PirateJetpack.desc }
ent-PirateJetpackBorg = mochila propulsora pirata de cíborg
    .suffix = Infinita, pirata
    .desc = Una mochila propulsora pirata modificada para que la usen los cíborgs.
ent-JetpackSalvage = mochila propulsora reacondicionada
    .suffix = Vacía
    .desc = Es una mochila propulsora vieja y desgastada. En su día contenía 0,8 l de gas, pero ahora solo se llena hasta la mitad.
ent-JetpackSalvageFilled = mochila propulsora reacondicionada
    .suffix = Llena
    .desc = { ent-JetpackSalvage.desc }
