set-game-preset-command-description = Define el preajuste de partida para el número indicado de rondas siguientes. También puede mostrar el título y la descripción de otro preajuste en el vestíbulo para despistar a los jugadores.
set-game-preset-command-help-text = setgamepreset <id> [número de rondas, 1 por defecto] [preajuste señuelo]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [número de rondas]
set-game-preset-command-hint-3 = [preajuste señuelo]

set-game-preset-optional-argument-not-integer = Si se indica el argumento 2, debe ser un número.
set-game-preset-preset-error = No se ha encontrado el preajuste de partida «{ $preset }»
set-game-preset-decoy-error = Si se indica el argumento 3, debe ser un preajuste válido. No se ha encontrado el preajuste de partida «{ $preset }»

# set-game-preset-preset-set = Preajuste de partida establecido en «{ $preset }»
set-game-preset-preset-set-finite = Preajuste de partida establecido en «{ $preset }» durante las próximas { $rounds } rondas.
set-game-preset-preset-set-finite-with-decoy = Preajuste de partida establecido en «{ $preset }» durante las próximas { $rounds } rondas, mostrando { $decoy } en el vestíbulo.
