reagent-name-carpetium = carpetium
reagent-desc-carpetium = Sustancia mística, normalmente importada del Planeta Payaso, que cubre de moqueta todo lo que toca. No se sabe cómo, pero filtra la carpotoxina del torrente sanguíneo.

reagent-name-fiber = fibra
