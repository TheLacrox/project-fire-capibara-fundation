### Localización utilizada por el comando listverbs.
# Principalmente ayuda y mensajes de error.

list-verbs-command-description = Enumera todos los verbos que un jugador puede usar sobre una entidad determinada.
list-verbs-command-help = listverbs <playerUid | "self"> <targetUid>

list-verbs-command-invalid-args = listverbs admite 2 argumentos.

list-verbs-command-invalid-player-uid = No se pudo interpretar el UID del jugador o no se indicó "self".
list-verbs-command-invalid-target-uid = No se pudo interpretar el UID del objetivo.

list-verbs-command-invalid-player-entity = El UID del jugador indicado no corresponde a una entidad válida.
list-verbs-command-invalid-target-entity = El UID del objetivo indicado no corresponde a una entidad válida.

list-verbs-verb-listing = { $type }: { $verb }
