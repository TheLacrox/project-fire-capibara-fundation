### Localización utilizada por el comando invokeverb.
# Principalmente ayuda y mensajes de error.

invoke-verb-command-description = Invoca el verbo indicado sobre una entidad y usa la entidad del jugador como usuario
invoke-verb-command-help = invokeverb <playerUid | "self"> <targetUid> <verbName | "interaction" | "activation" | "alternative">

invoke-verb-command-invalid-args = invokeverb admite 2 argumentos.

invoke-verb-command-invalid-player-uid = No se pudo interpretar el UID del jugador o no se indicó "self".
invoke-verb-command-invalid-target-uid = No se pudo interpretar el UID del objetivo.

invoke-verb-command-invalid-player-entity = El UID del jugador indicado no corresponde a una entidad válida.
invoke-verb-command-invalid-target-entity = El UID del objetivo indicado no corresponde a una entidad válida.

invoke-verb-command-success = Se ha invocado el verbo «{ $verb }» sobre { $target }, con { $player } como usuario.

invoke-verb-command-verb-not-found = No se encontró el verbo { $verb } en { $target }.
