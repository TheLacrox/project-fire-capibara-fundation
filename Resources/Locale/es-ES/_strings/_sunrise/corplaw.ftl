corplaw-program-name = Derecho corporativo

# Se muestra cuando la PDA no está conectada a una estación con legislación corporativa.
corplaw-no-connection = Sin conexión
corplaw-no-connection-desc = Esta PDA no está conectada a una estación que disponga de legislación corporativa.

