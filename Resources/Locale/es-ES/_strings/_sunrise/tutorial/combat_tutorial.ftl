    .suffix = Tutorial

ent-CombatTutorialTargetHuman = compañero de entrenamiento
    .desc = Un voluntario preparado para prácticas seguras de defensa personal.
    .suffix = Tutorial

ent-CombatTutorialTargetSpawner = generador de compañero de entrenamiento
    .desc = Genera un compañero de entrenamiento.
    .suffix = Tutorial

ent-CombatTutorialPlayer = alumno
    .desc = Un participante en un ejercicio de defensa personal.
    .suffix = Tutorial
