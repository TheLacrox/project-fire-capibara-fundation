scp-radio-cycle-channel = Cambiar el canal de comunicación
scp-radio-toggle-radio = Encender/apagar
scp-radio-current-channel = El canal de comunicación actual ahora es: { $name }
scp-radio-microphone =
    Micrófono { $value ->
        [true] encendido
       *[false] apagado
    }
scp-radio-radio-status =
    Radio: { $value ->
        [true] [bold]encendida[/bold]
       *[false] [bold]apagada[/bold]
    }
scp-radio-microphone-status =
    Micrófono: { $value ->
        [true] [bold]encendido[/bold]
       *[false] [bold]apagado[/bold]
    }
scp-radio-not-enough-charge = No hay carga suficiente
scp-radio-toggle-message =
    { $name } { $value ->
        [true] se enciende
       *[false] se apaga
    }
