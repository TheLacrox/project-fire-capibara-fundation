body-takeover-poll-window-title = Entidad disponible
body-takeover-poll-window-body = OOC: Se necesita un jugador para { $entity }. ¿Quieres tomar el control?
body-takeover-poll-window-accept = Sí
body-takeover-poll-window-decline = No

body-takeover-transfer-window-title = Asignación de entidad
body-takeover-transfer-window-body = OOC: Se te ha seleccionado para tomar el control de { $entity }. Dispones de { $delay } antes de la transferencia automática.
body-takeover-transfer-window-now = Transferir ahora
body-takeover-transfer-window-wait = Esperar
body-takeover-transfer-window-decline = Rechazar

body-takeover-delay-minutes = { $count ->
    [one] { $count } minuto
    *[other] { $count } minutos
}
body-takeover-delay-seconds = { $count ->
    [one] { $count } segundo
    *[other] { $count } segundos
}
