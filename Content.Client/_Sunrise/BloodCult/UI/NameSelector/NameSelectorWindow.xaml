        <Label Text="{Loc 'fire-blood-cult-name-prompt'}" />
        <LineEdit Name="NameSelector" HorizontalExpand="True" />
        <Button Name="NameSelectorSet" Text="{Loc 'fire-blood-cult-selector-accept'}" />
    </BoxContainer>
</DefaultWindow>
