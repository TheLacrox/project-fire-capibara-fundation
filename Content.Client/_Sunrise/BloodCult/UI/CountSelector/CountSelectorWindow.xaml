<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="{Loc 'fire-blood-cult-selector-title'}">
    <BoxContainer Orientation="Vertical">
        <Label Text="{Loc 'fire-blood-cult-count-prompt'}" HorizontalAlignment="Center" />
        <Label Text="{Loc 'fire-blood-cult-count-minimum'}" StyleClasses="LabelKeyText" HorizontalAlignment="Center" />
        <LineEdit Name="CountSelector" HorizontalExpand="True" />
        <Button Name="CountSelectorSet" Text="{Loc 'fire-blood-cult-selector-accept'}" />
    </BoxContainer>
</DefaultWindow>
